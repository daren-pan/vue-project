FROM m.daocloud.io/docker.io/library/maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /workspace

# ① 只复制 pom.xml，下载所有依赖（pom.xml 不变则复用缓存，跳过下载）
COPY pom.xml settings.xml ./
COPY ruoyi-common/pom.xml ./ruoyi-common/
COPY ruoyi-common/ruoyi-common-core/pom.xml ./ruoyi-common/ruoyi-common-core/
COPY ruoyi-common/ruoyi-common-datascope/pom.xml ./ruoyi-common/ruoyi-common-datascope/
COPY ruoyi-common/ruoyi-common-datasource/pom.xml ./ruoyi-common/ruoyi-common-datasource/
COPY ruoyi-common/ruoyi-common-log/pom.xml ./ruoyi-common/ruoyi-common-log/
COPY ruoyi-common/ruoyi-common-redis/pom.xml ./ruoyi-common/ruoyi-common-redis/
COPY ruoyi-common/ruoyi-common-security/pom.xml ./ruoyi-common/ruoyi-common-security/
COPY ruoyi-common/ruoyi-common-swagger/pom.xml ./ruoyi-common/ruoyi-common-swagger/
COPY ruoyi-api/pom.xml ./ruoyi-api/
COPY ruoyi-api/ruoyi-api-system/pom.xml ./ruoyi-api/ruoyi-api-system/
COPY ruoyi-auth/pom.xml ./ruoyi-auth/
COPY ruoyi-gateway/pom.xml ./ruoyi-gateway/
COPY ruoyi-visual/pom.xml ./ruoyi-visual/
COPY ruoyi-visual/ruoyi-monitor/pom.xml ./ruoyi-visual/ruoyi-monitor/
COPY ruoyi-modules/pom.xml ./ruoyi-modules/
COPY ruoyi-modules/ruoyi-system/pom.xml ./ruoyi-modules/ruoyi-system/
RUN mvn -s settings.xml dependency:go-offline -pl ruoyi-modules/ruoyi-system -am -q

# ② 复制源码，只编译（依赖已缓存，这步只需编译）
COPY ruoyi-common ./ruoyi-common
COPY ruoyi-api ./ruoyi-api
COPY ruoyi-auth ./ruoyi-auth
COPY ruoyi-gateway ./ruoyi-gateway
COPY ruoyi-visual ./ruoyi-visual
COPY ruoyi-modules ./ruoyi-modules
RUN mvn -s settings.xml clean package -DskipTests -pl ruoyi-modules/ruoyi-system -am

FROM m.daocloud.io/docker.io/library/eclipse-temurin:17-jre
MAINTAINER ruoyi
VOLUME /home/ruoyi
RUN mkdir -p /home/ruoyi
WORKDIR /home/ruoyi
COPY --from=builder /workspace/ruoyi-modules/ruoyi-system/target/ruoyi-modules-system.jar /home/ruoyi/ruoyi-modules-system.jar
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar ruoyi-modules-system.jar"]

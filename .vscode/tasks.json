{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ruoyi-ui 开发服务器",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/ruoyi-ui"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "webpack",
                "pattern": {
                    "regexp": "ERROR\\s+(.*)",
                    "file": 1,
                    "severity": "error"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*Compiled successfully.*|.*webpack.*compiled.*|.*DONE.*"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}

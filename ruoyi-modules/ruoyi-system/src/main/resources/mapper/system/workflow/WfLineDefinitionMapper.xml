<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.workflow.WfLineDefinitionMapper">

    <resultMap type="com.ruoyi.system.domain.workflow.WfLineDefinition" id="WfLineDefinitionResult">
        <id property="id" column="id"/>
        <result property="processDefId" column="process_def_id"/>
        <result property="fromNodeId" column="from_node_id"/>
        <result property="toNodeId" column="to_node_id"/>
        <result property="conditionExpression" column="condition_expression"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectVo">
        SELECT id, process_def_id, from_node_id, to_node_id, condition_expression, sort_order, create_by, create_time
        FROM wf_line_definition
    </sql>

    <select id="selectWfLineDefinitionById" parameterType="Long" resultMap="WfLineDefinitionResult">
        <include refid="selectVo"/> WHERE id = #{id}
    </select>

    <select id="selectByProcessAndFromNodeId" resultMap="WfLineDefinitionResult">
        <include refid="selectVo"/> WHERE process_def_id = #{processDefId} AND from_node_id = #{fromNodeId} ORDER BY sort_order
    </select>

    <select id="selectWfLineDefinitionByProcessDefId" parameterType="Long" resultMap="WfLineDefinitionResult">
        <include refid="selectVo"/> WHERE process_def_id = #{processDefId} ORDER BY sort_order
    </select>

    <select id="selectWfLineDefinitionList" parameterType="com.ruoyi.system.domain.workflow.WfLineDefinition" resultMap="WfLineDefinitionResult">
        <include refid="selectVo"/>
        <where>
            <if test="processDefId != null">AND process_def_id = #{processDefId}</if>
        </where>
        ORDER BY sort_order
    </select>

    <insert id="insertWfLineDefinition" parameterType="com.ruoyi.system.domain.workflow.WfLineDefinition" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO wf_line_definition(process_def_id, from_node_id, to_node_id, condition_expression, sort_order, create_by, create_time)
        VALUES (#{processDefId}, #{fromNodeId}, #{toNodeId}, #{conditionExpression}, #{sortOrder}, #{createBy}, SYSDATE())
    </insert>

    <update id="updateWfLineDefinition" parameterType="com.ruoyi.system.domain.workflow.WfLineDefinition">
        UPDATE wf_line_definition
        SET from_node_id = #{fromNodeId}, to_node_id = #{toNodeId},
            condition_expression = #{conditionExpression}, sort_order = #{sortOrder}
        WHERE id = #{id}
    </update>

    <delete id="deleteWfLineDefinitionByProcessDefId" parameterType="Long">
        DELETE FROM wf_line_definition WHERE process_def_id = #{processDefId}
    </delete>

</mapper>

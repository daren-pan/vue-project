<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.workflow.WfAuditRecordMapper">

    <resultMap type="com.ruoyi.system.domain.workflow.WfAuditRecord" id="WfAuditRecordResult">
        <id property="id" column="id"/>
        <result property="instanceId" column="instance_id"/>
        <result property="businessTable" column="business_table"/>
        <result property="businessId" column="business_id"/>
        <result property="nodeId" column="node_id"/>
        <result property="nodeName" column="node_name"/>
        <result property="assignee" column="assignee"/>
        <result property="action" column="action"/>
        <result property="comment" column="comment"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="completeTime" column="complete_time"/>
    </resultMap>

    <sql id="selectVo">
        SELECT id, instance_id, business_table, business_id, node_id, node_name, assignee, action, comment, status, create_time, complete_time
        FROM wf_audit_record
    </sql>

    <select id="selectWfAuditRecordById" parameterType="Long" resultMap="WfAuditRecordResult">
        <include refid="selectVo"/> WHERE id = #{id}
    </select>

    <select id="selectByInstanceAndNodeAndAssignee" resultMap="WfAuditRecordResult">
        <include refid="selectVo"/>
        WHERE instance_id = #{instanceId} AND node_id = #{nodeId} AND assignee = #{assignee}
    </select>

    <select id="selectByInstanceId" parameterType="Long" resultMap="WfAuditRecordResult">
        <include refid="selectVo"/> WHERE instance_id = #{instanceId} ORDER BY create_time
    </select>

    <select id="selectByBusiness" resultMap="WfAuditRecordResult">
        <include refid="selectVo"/>
        WHERE business_table = #{businessTable} AND business_id = #{businessId}
        ORDER BY create_time
    </select>

    <select id="selectWfAuditRecordList" parameterType="com.ruoyi.system.domain.workflow.WfAuditRecord" resultMap="WfAuditRecordResult">
        <include refid="selectVo"/>
        <where>
            <if test="instanceId != null">AND instance_id = #{instanceId}</if>
            <if test="assignee != null and assignee != ''">AND assignee = #{assignee}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        ORDER BY create_time
    </select>

    <insert id="insertWfAuditRecord" parameterType="com.ruoyi.system.domain.workflow.WfAuditRecord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO wf_audit_record(instance_id, business_table, business_id, node_id, node_name, assignee, action, comment, status, create_time, complete_time)
        VALUES (#{instanceId}, #{businessTable}, #{businessId}, #{nodeId}, #{nodeName}, #{assignee}, #{action}, #{comment}, #{status}, SYSDATE(), #{completeTime})
    </insert>

    <update id="updateWfAuditRecord" parameterType="com.ruoyi.system.domain.workflow.WfAuditRecord">
        UPDATE wf_audit_record
        SET action = #{action}, comment = #{comment}, status = #{status}, complete_time = #{completeTime}
        WHERE id = #{id}
    </update>

    <delete id="deleteWfAuditRecordByInstanceId" parameterType="Long">
        DELETE FROM wf_audit_record WHERE instance_id = #{instanceId}
    </delete>

</mapper>
